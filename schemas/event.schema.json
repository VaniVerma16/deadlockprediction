{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/deadlock-event.schema.json",
  "title": "Deadlock observation event",
  "type": "object",
  "required": ["run_id", "ts_ns", "source", "event"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "ts_ns": {"type": "integer", "minimum": 0},
    "source": {"enum": ["ebpf", "workload", "perf", "controller"]},
    "event": {"type": "string", "minLength": 1},
    "pid": {"type": "integer", "minimum": 0},
    "tid": {"type": "integer", "minimum": 0},
    "worker": {"type": "integer", "minimum": -1},
    "lock_addr": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
    "ret": {"type": "integer"},
    "cpu": {"type": "integer", "minimum": 0},
    "scenario": {"type": "string"},
    "seed": {"type": "integer", "minimum": 0},
    "mode": {"enum": ["safe", "deadlock"]},
    "value": {},
    "details": {"type": "object"}
  },
  "additionalProperties": true
}
